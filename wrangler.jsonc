{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pctgp-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pctgp-website"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "pctgp-website-media"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
