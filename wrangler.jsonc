{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pctgp-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pctgp-website",
			"database_id": "8499037b-11f3-4e62-9023-4181cdc490c0"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
